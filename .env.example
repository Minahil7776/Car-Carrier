# Paste your MongoDB connection string here (Atlas or self-hosted)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority"
MONGODB_DB="carrier_hub"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Display timezone for greetings and dates
APP_TIMEZONE="Asia/Karachi"

# Super Administrator created by `npm run seed` (SRS 3.1: seeded at deployment)
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
